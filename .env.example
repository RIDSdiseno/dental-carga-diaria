# ============================================================
#  dental-carga-diaria — credenciales y parámetros
#  Copia este archivo como ".env" y complétalo. El .env NO se sube a git.
#  Claude nunca lee ni escribe los valores de este archivo: solo lo lee el script.
# ============================================================

# Webs (producción de prueba). No cambiar salvo que se muevan.
DC_BASE_URL=https://dentalcloudia.netlify.app
DD_BASE_URL=https://dentalaicloud.netlify.app

# Superadmin de DentalCloud (crea holdings y activa la federación).
DC_SUPERADMIN_EMAIL=
DC_SUPERADMIN_PASSWORD=

# Contraseña que se asigna a TODOS los usuarios que crea el proceso
# (administrador inicial, odontólogos, operadores). Mínimo 8 caracteres.
# Si se deja vacía, el script genera una, la guarda en data/clave-usuarios.txt
# y la incluye en el Word diario.
DEFAULT_USER_PASSWORD=

# ---- Parámetros de la carga diaria ----
CLINICS_PER_DAY=10
PATIENTS_PER_DAY=300
# Cuántas clínicas se pueblan al mismo tiempo (cada una abre su propio navegador).
PARALLEL_CLINICS=3
# Proporción de pacientes con foto (0.25 = 1 de cada 4).
PHOTO_RATIO=0.25
# Prefijo fijo que llevan todas las clínicas creadas por el proceso.
CLINIC_PREFIX=Demo
# Dominio inexistente para los correos ficticios (nunca se envía correo real).
FAKE_EMAIL_DOMAIN=demo-fordent.invalid

# ---- Informe Word diario ----
# Carpeta donde se guarda "Carga YYYY-MM-DD.docx" con clínicas, pacientes y credenciales.
# Si se deja vacío: <Escritorio>\Carga Diaria Dental
WORD_REPORT_DIR=

# ---- Navegador ----
# true = sin ventana (recomendado para la tarea programada). false = ver el navegador.
HEADLESS=true
# Milisegundos de pausa entre acciones (solo para observar; 0 en producción).
SLOW_MO=0
ACTION_TIMEOUT_MS=20000
